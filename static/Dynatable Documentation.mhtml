e" class=3D"table table-bordered">
  <thead>
    <tr><th data-dynatable-column=3D"someAttribute" class=3D"dynatable-head=
">Some Attribute</th>
    <th data-dynatable-column=3D"someOtherAttribute" class=3D"dynatable-hea=
d">Some Other Attribute</th>
  </tr></thead>
