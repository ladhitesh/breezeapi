# Flask Core
FLASK_APP=run.py
FLASK_DEBUG=True
FLASK_SECRET_KEY=change-this-to-a-secure-32-char-random-string

# Network
HOST=127.0.0.1
PORT=5000
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Broker Credentials (Do not put real keys in the example file)
IDIRECT_API_KEY=your_idirect_key
IDIRECT_SECRET_KEY=your_idirect_secret

UPSTOX_API_KEY=your_upstox_key
UPSTOX_SECRET_KEY=your_upstox_secret
UPSTOX_REDIRECT_URL=http://127.0.0.1:5000/authorize

# Logging
LOG_LEVEL=INFO